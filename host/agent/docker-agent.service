[Unit]
Description=Selfhost dashboard Docker agent
After=docker.service network-online.target
Requires=docker.service
[Service]
# LAN-IP dieses Hosts eintragen (nicht 0.0.0.0); Port 9102 per Firewall nur fürs Dashboard öffnen
Environment=BIND=192.168.1.22
ExecStart=/usr/bin/python3 /opt/selfhost-dash-agent/docker-agent.py
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
