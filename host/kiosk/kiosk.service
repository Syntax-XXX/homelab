[Unit]
Description=TV-Kiosk (selfhost Dashboard) auf dem lokalen Monitor
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UnsetEnvironment=TERM
ExecStart=/usr/bin/startx /home/kiosk/.xinitrc -- :0 vt1 -keeptty -nolisten tcp
Restart=always
RestartSec=5
# Darf den VMs nicht den RAM wegnehmen
OOMScoreAdjust=500
Nice=5

[Install]
WantedBy=multi-user.target
