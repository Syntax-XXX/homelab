# Comet – Debrid-Scraper (https://github.com/g0ldyy/comet)
ADMIN_DASHBOARD_PASSWORD=__RANDOM__
DATABASE_TYPE=sqlite
DATABASE_PATH=data/comet.db
FASTAPI_PORT=8000
# Prowlarr als zusätzliche Quelle (API-Key: Prowlarr → Settings → General)
SCRAPE_PROWLARR=live
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
SCRAPE_TORRENTIO=live
SCRAPE_ZILEAN=live
SCRAPE_NYAA=False
INDEXER_LANGUAGES=["de"]
# eigener StremThru, weil manche Debrid-Dienste öffentliche Proxys sperren
STREMTHRU_URL=http://stremthru:8080
LIVE_SCRAPE_TIMEOUT=15
INDEXER_MANAGER_TIMEOUT=15
