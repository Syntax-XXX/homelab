# Release-Center – prüft Builds (gitleaks + KI) und pusht nach GitHub
FORGEJO_URL=http://__HOST_IP__:3300
FORGEJO_PUBLIC_URL=http://git.local
# Forgejo → Einstellungen → Anwendungen → Token (read:repository, read:user, write:repository)
FORGEJO_TOKEN=
# Kostenloser Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GitHub → Settings → Developer settings → Fine-grained token (Administration + Contents: read/write)
GITHUB_USER=
GITHUB_TOKEN=
UI_USER=admin
UI_PASSWORD=__RANDOM__
PUBLIC_URL=http://release.local
CODE_URL=http://code.local
DASHBOARD_URL=http://selfhost.local
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BUILDS_HINT=NAS: builds
