# Selfhost-Dashboard
# Token für die Stats-Agents auf den Proxmox-Hosts (gleicher Wert in /etc/selfhost-dash/token)
AGENT_TOKEN=__RANDOM__
# zweiter Token für Aktionen (Start/Stop), /etc/selfhost-dash/action_token
ACTION_TOKEN=__RANDOM__
KUMA_URL=http://host.docker.internal:3001
DOZZLE_URL=http://dozzle.local
# Proxmox-Knoten mit Agent (weitere werden aus dem Cluster erkannt)
AGENTS=pve1=http://192.168.1.10:9101
# Docker-Hosts: name=local@IP oder name=http://IP:9102@IP (docker-agent)
DOCKER_HOSTS=selfhost=local@192.168.1.21
# VMs/Container, die nie per Knopf gestoppt werden dürfen
PROTECT_GUESTS=
PROTECT_CONTAINERS=selfhost/dashboard
# Telegram-Bot (optional): Token von @BotFather, Chat-ID von @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_IDS=
# Server-Management-Controller per IPMI (optional, z. B. Fujitsu iRMC / Dell iDRAC / HP iLO)
BMC_HOST=
BMC_USER=admin
BMC_PASS=
BMC_NODE=pve1
BMC_NAME=iRMC
# Synology NAS über DSM-API (optional)
NAS_URL=
NAS_USER=
NAS_PASS=
NAS_NAME=NAS
