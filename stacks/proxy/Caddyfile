# Reverse-Proxy: hübsche Namen statt IP:Port.
# Die Namen *.local werden per mDNS veröffentlicht (host/avahi) – alternativ im Router-DNS eintragen.
{
	auto_https off
}
(app) {
	reverse_proxy host.docker.internal:{args[0]}
}
http://jellyfin.local {
	import app 8096
}
http://seerr.local {
	import app 5055
}
http://sonarr.local {
	import app 8989
}
