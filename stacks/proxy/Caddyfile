# Cloud-Stack (läuft mit CLOUD_HTTP_PORT=8081 auf demselben Host)
http://nextcloud.local, http://paperless.local, http://guacamole.local, http://obsidian.local {
	reverse_proxy host.docker.internal:8081
}
# alles andere (IP, selfhost.local) -> Dashboard
http:// {
	import app 3000
}
