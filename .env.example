# ===== Globale Einstellungen für alle Stacks =====
# setup.sh kopiert diese Datei nach .env, füllt Passwörter zufällig und verlinkt sie in jeden Stack.

# IP-Adresse des Docker-Hosts im LAN (z. B. 192.168.1.21)
HOST_IP=192.168.1.21
TZ=Europe/Berlin
# User/Gruppe, denen die Daten gehören (id -u / id -g)
PUID=1000
PGID=1000
# GID der docker-Gruppe: getent group docker | cut -d: -f3
DOCKER_GID=989
ADMIN_USER=admin

# ===== Speicherorte =====
APPDATA=/opt/appdata            # Konfiguration aller Apps (SSD!)
MEDIA_DATA=/srv/media/data      # Medien + Downloads (gleiches Dateisystem = Hardlinks!)
CLOUD_DATA=/srv/data            # Nextcloud/Paperless-Dateien
GIT_STORAGE=/srv/git            # Forgejo-Repos + Code-Workspace (gerne NAS per NFS)

# ===== Media =====
JELLYFIN_CPUS=4

# ===== Dev =====
FORGEJO_DOMAIN=git.local
FORGEJO_ROOT_URL=http://git.local/
CODE_PASSWORD=__RANDOM__

# Cloud-Stack auf demselben Host wie der proxy-Stack? Dann 8081 (proxy leitet *.local weiter)
CLOUD_HTTP_PORT=8081

# ===== Cloud (wird von setup.sh zufällig gefüllt) =====
POSTGRES_PASSWORD=__RANDOM__
NEXTCLOUD_DB_PASS=__RANDOM__
PAPERLESS_DB_PASS=__RANDOM__
GUACAMOLE_DB_PASS=__RANDOM__
REDIS_PASSWORD=__RANDOM__
PAPERLESS_SECRET_KEY=__RANDOM__
NEXTCLOUD_ADMIN_PASSWORD=__RANDOM__
PAPERLESS_ADMIN_PASSWORD=__RANDOM__
COUCHDB_PASSWORD=__RANDOM__
